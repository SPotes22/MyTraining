# ── Entorno ─────────────────────────────────────────────────────────────
# development | preproduction | production
# Fuera de "development" la app NO arranca sin SECRET_KEY y SUPERUSER_PASSWORD
# propias (ni con valores que alguna vez se publicaron en el repositorio).
APP_ENV=development

# Genera uno con:  python -c "import secrets; print(secrets.token_hex(32))"
# Vacío en development = se genera uno aleatorio en cada arranque (las sesiones se cierran al reiniciar).
SECRET_KEY=

# SQLite (MVP / pre-producción). Ruta relativa = carpeta instance/.
# En un contenedor apunta a un volumen persistente, p. ej. sqlite:////data/mytraining.db
DATABASE_URL=sqlite:///database.db
# PostgreSQL (producción, cuando la base de usuarios lo justifique):
# DATABASE_URL=postgresql+psycopg://<USUARIO>:<CLAVE>@<HOST>:5432/mytraining

# ── Superusuario inicial (solo se crea si no existe) ────────────────────
SUPERUSER_EMAIL=admin@capacitacion.com
# Vacío en development = se genera una contraseña aleatoria y se muestra UNA vez en la consola.
# Obligatoria fuera de development (mínimo 8 caracteres). Nunca la escribas en el repositorio.
SUPERUSER_PASSWORD=
SUPERUSER_USERNAME=SuperAdmin
# true = reescribe la contraseña desde aquí en cada arranque (default solo en development)
# SUPERUSER_RESET_ON_BOOT=false
# true = crea profesor/examen de demostración (default solo en development)
# SEED_DEMO_DATA=false
# Contraseña del profesor demo; vacía = aleatoria, mostrada en consola
# DEMO_INSTRUCTOR_PASSWORD=

# ── Seguridad y límites ─────────────────────────────────────────────────
# SESSION_COOKIE_SECURE=true      # default true fuera de development (requiere HTTPS)
# SOCKETIO_CORS_ORIGINS=https://mytraining.example.com   # vacío = solo mismo origen
# PROXY_FIX_HOPS=1                # proxies delante (Nginx / balanceador GCP)
# MAX_UPLOAD_MB=201                  # tope por petición (≥ el mayor de los de abajo); igual en Nginx
# UPLOAD_IMAGE_MB=10
# UPLOAD_VIDEO_MB=200
# UPLOAD_AUDIO_MB=20
# UPLOAD_DOCUMENT_MB=20
# UPLOAD_IMPORT_MB=5                 # CSV, Excel y JSON de importación
# MIN_PASSWORD_LENGTH=8
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCKOUT_SECONDS=900

# ── Correo saliente (recuperar contraseña, RF-028) ──────────────────────
# Sin MAIL_SERVER: en development el enlace se imprime en la consola;
# fuera de development no se envía y queda una advertencia en el log.
# MAIL_SERVER=smtp.<PROVEEDOR>.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=<USUARIO_SMTP>
# MAIL_PASSWORD=<CLAVE_SMTP>          # nunca en el repositorio
# MAIL_FROM=no-responder@<TU_DOMINIO>
# PASSWORD_RESET_MAX_AGE=1800         # segundos (30 min)
# PASSWORD_RESET_MAX_REQUESTS=3       # solicitudes por correo y hora

# ── Responsable del tratamiento de datos (Ley 1581, RL-02) ──────────────
# Aparecen en /terminos y /politica-de-datos. Obligatorias fuera de development.
# LEGAL_ENTITY_NAME=<NOMBRE O RAZÓN SOCIAL>
# LEGAL_ENTITY_ID=<NIT O CÉDULA>
# LEGAL_CONTACT_EMAIL=datos@<TU_DOMINIO>
# LEGAL_ADDRESS=<DIRECCIÓN, CIUDAD>
# GUEST_RETENTION_DAYS=90            # invitados anonimizados por scripts/anonymize_guests.py

# ── Servidor (gunicorn.conf.py) ─────────────────────────────────────────
# PORT=8080
# GUNICORN_THREADS=256               # = tope de estudiantes conectados a la vez (+ ~30 HTTP)
# LOG_LEVEL=info                     # debug | info | warning | error (app y Gunicorn)
# LOG_FORMAT=json                    # json (por defecto fuera de desarrollo) | text
