# ── Entorno ─────────────────────────────────────────────────────────────
# development | preproduction | production
# Fuera de "development" la app NO arranca si SECRET_KEY o SUPERUSER_PASSWORD
# conservan los valores de ejemplo.
APP_ENV=development

# Genera uno con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=clave-secreta-capacitacion-2026

# SQLite (MVP / pre-producción). Ruta relativa = carpeta instance/.
# En un contenedor apunta a un volumen persistente, p. ej. sqlite:////data/mytraining.db
DATABASE_URL=sqlite:///database.db
# PostgreSQL (producción, cuando la base de usuarios lo justifique):
# DATABASE_URL=postgresql+psycopg://usuario:clave@host:5432/mytraining

# ── Superusuario inicial (solo se crea si no existe) ────────────────────
SUPERUSER_EMAIL=admin@capacitacion.com
SUPERUSER_PASSWORD=admin1234
SUPERUSER_USERNAME=SuperAdmin
# true = reescribe la contraseña desde aquí en cada arranque (default solo en development)
# SUPERUSER_RESET_ON_BOOT=false
# true = crea profesor/examen de demostración (default solo en development)
# SEED_DEMO_DATA=false

# ── Seguridad y límites ─────────────────────────────────────────────────
# SESSION_COOKIE_SECURE=true      # default true fuera de development (requiere HTTPS)
# SOCKETIO_CORS_ORIGINS=https://mytraining.example.com   # vacío = solo mismo origen
# PROXY_FIX_HOPS=1                # proxies delante (Nginx / balanceador GCP)
# MAX_UPLOAD_MB=50
# MIN_PASSWORD_LENGTH=8
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCKOUT_SECONDS=900

# ── Servidor (gunicorn.conf.py) ─────────────────────────────────────────
# PORT=8080
# GUNICORN_THREADS=64
# LOG_LEVEL=info
